{
  "name": "caveauone-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "env-cmd -f .env.staging expo start",
    "start:prod": "env-cmd -f .env.production expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:staging": "env-cmd -f .env.staging npx eas-cli@latest build --profile preview --platform all --auto-submit",
    "build:production": "env-cmd -f .env.production npx eas-cli@latest build --profile production --platform all --auto-submit",
    "build:staging:ios": "env-cmd -f .env.staging npx eas-cli@latest build --profile preview --platform ios --auto-submit",
    "build:production:ios": "env-cmd -f .env.production npx eas-cli@latest build --profile production --platform ios --auto-submit",
    "ios-device": "env-cmd -f .env.staging expo run:ios --device",
    "ios-device:prod": "env-cmd -f .env.production expo run:ios --device",
    "ios-ipad": "env-cmd -f .env.staging expo run:ios -d 'iPad Pro 11-inch (M4)'",
    "ios-ipad:prod": "env-cmd -f .env.production expo run:ios -d 'iPad Pro 11-inch (M4)'",
    "eas-update": "npx eas-cli update --channel production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.12.1",
    "lucide-react-native": "^1.14.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/jest": "^29",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.0",
    "env-cmd": "^11.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "jest-expo": "^56.0.5",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2"
  },
  "private": true
}
